# Metabase CLI configuration
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# These are NOT read automatically by the `mb` CLI. They exist so a teammate
# has one obvious place to put credentials, and so `scripts/mb-login.sh` can
# feed them to `mb auth login`, which stores the real session/API key in the
# CLI's own profile store (outside this repo).

MB_URL=<METABASE_URL>
MB_API_KEY=<METABASE_API_KEY>

# Name of the `mb` CLI auth profile to create/use for this project.
# Run `mb auth list` to see what profiles already exist on this machine
# before picking a new name.
MB_PROFILE=recruitcrm
